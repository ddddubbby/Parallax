# App
APP_ENV=development
APP_URL=http://localhost:3000
APP_PASSWORD=
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parallax

# Cost defaults
DEFAULT_VALIDATION_RUN_CAP_USD=2
DEFAULT_AUDIT_RUN_CAP_USD=25
# Global default daily budget; <PROVIDER>_DAILY_BUDGET_USD overrides it per provider (D-012)
PROVIDER_DAILY_BUDGET_USD=25
DEEPSEEK_DAILY_BUDGET_USD=

# First live validation provider
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Candidate second validation provider
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_DEFAULT_MODEL=MiniMax-M3

# LLM provider API keys are not env vars. Enter them in the authenticated Settings UI.
# The app stores them encrypted at rest using CREDENTIALS_ENCRYPTION_KEY.

# Observability
SENTRY_DSN=
