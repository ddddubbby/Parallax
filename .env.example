# App
APP_ENV=development
APP_URL=http://localhost:3000
APP_PASSWORD=
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parallax

# Cost defaults
DEFAULT_VALIDATION_RUN_CAP_USD=2
DEFAULT_AUDIT_RUN_CAP_USD=25
# Global default daily budget; <PROVIDER>_DAILY_BUDGET_USD overrides it per provider (D-012)
PROVIDER_DAILY_BUDGET_USD=25
DEEPSEEK_DAILY_BUDGET_USD=

# First live validation provider
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Grounded audit providers (M9). Defaults verified against official docs 2026-07-03.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_DAILY_BUDGET_USD=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_DAILY_BUDGET_USD=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash
GOOGLE_DAILY_BUDGET_USD=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_DEFAULT_MODEL=sonar
PERPLEXITY_DAILY_BUDGET_USD=

# Optional outbound proxy for provider API calls. Node workers do not inherit
# macOS system-proxy settings; configure these explicitly when required.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# D-041: the ONE extraction engine used for every live run's structured
# extraction, regardless of which provider generated the response. Only
# deepseek has an extraction adapter; a live run on any provider requires
# an active credential for this engine too.
EXTRACTION_PROVIDER=deepseek

# Candidate second validation provider (PV-3, not built)
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_DEFAULT_MODEL=MiniMax-M3

# LLM provider API keys are not env vars. Enter them in the authenticated Settings UI.
# The app stores them encrypted at rest using CREDENTIALS_ENCRYPTION_KEY.

# GEO agent — managed RPC URLs for live on-chain identity resolution (M38+).
# Never rate-limited public endpoints (§5.1). Optional for the OpenAI live
# validation harness — omit them and pass --name/--symbol for a fixture identity.
BASE_RPC_URL=
ETHEREUM_RPC_URL=

# Observability
SENTRY_DSN=
