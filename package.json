{
  "name": "parallax",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh scripts/dev-all.sh",
    "build": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/docs-check.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx scripts/test-db.ts",
    "test:mock-e2e": "tsx scripts/test-mock-e2e.ts",
    "test:golden": "vitest run src/modules/extraction/golden.test.ts",
    "audit:deepseek-mini": "tsx scripts/audit-deepseek-mini.ts",
    "archive:evidence": "tsx scripts/archive-evidence.ts",
    "demo:walkthrough": "tsx scripts/demo-walkthrough.ts",
    "demo:resonance": "tsx scripts/demo-resonance.ts",
    "recompute:resonance": "tsx scripts/recompute-resonance.ts",
    "research:retired:m34:extract": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/extract-frames.ts",
    "research:retired:m34:neutral": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/neutral-mini-run.ts",
    "research:retired:m34:analyze": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/analyze.ts",
    "research:retired:m34:v3:preregister": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-preregister.ts",
    "research:retired:m34:v3:controls": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-controls.ts",
    "research:retired:m34:v3:run": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-run.ts",
    "research:retired:m34:v3:review": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-review.ts",
    "research:retired:m34:v3:map": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-map.ts",
    "research:retired:m34:v3:analyze": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-analyze.ts",
    "research:retired:m34:v3:gold": "tsx scripts/framing-feasibility/retired-guard.ts && tsx scripts/framing-feasibility/v3-gold-packet.ts",
    "research:m34a:collect": "tsx scripts/framing-feasibility/m34a-collect.ts",
    "research:m34a:workflow": "tsx scripts/framing-feasibility/m34a-workflow.ts",
    "research:m34a:report": "tsx scripts/framing-feasibility/m34a-report.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.525.0",
    "marked": "^18.0.5",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "postcss": "^8.5.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
