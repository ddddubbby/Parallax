{
  "name": "parallax",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh scripts/dev-all.sh",
    "build": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:studio": "drizzle-kit studio",
    "test:mock-e2e": "tsx scripts/test-mock-e2e.ts",
    "test:golden": "vitest run src/modules/extraction/golden.test.ts",
    "audit:deepseek-mini": "tsx scripts/audit-deepseek-mini.ts",
    "archive:evidence": "tsx scripts/archive-evidence.ts",
    "demo:walkthrough": "tsx scripts/demo-walkthrough.ts",
    "demo:resonance": "tsx scripts/demo-resonance.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.44.0",
    "marked": "^18.0.5",
    "next": "^15.5.0",
    "pg": "^8.16.0",
    "postcss": "^8.5.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
